generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REVERSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum MovementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum MovementType {
  PURCHASE_RECEIPT
  WAREHOUSE_TRANSFER
  ISSUE_TO_TECHNICIAN
  RETURN_FROM_TECHNICIAN
  PLACE_AT_CUSTOMER
  WITHDRAW_FROM_CUSTOMER
  DAMAGED_OR_LOST
  STOCK_ADJUSTMENT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model Company {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("IDR")
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  branches          Branch[]
  accounts          Account[]
  cashAccounts      CashAccount[]
  customers         Customer[]
  suppliers         Supplier[]
  servicePackages   ServicePackage[]
  itemCategories    ItemCategory[]
  items             Item[]
  invoices          Invoice[]
  payments          Payment[]
  purchases         Purchase[]
  stockMovements    StockMovement[]
  budgets           Budget[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
}

model DocumentSequence {
  id           String   @id @default(uuid())
  companyId    String
  documentType String
  prefix       String
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, documentType])
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]
  customers  Customer[]
  invoices   Invoice[]
  payments   Payment[]
  purchases  Purchase[]
  budgets    Budget[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Warehouse {
  id        String   @id @default(uuid())
  branchId  String
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch            Branch             @relation(fields: [branchId], references: [id])
  inventoryBalances InventoryBalance[]
  purchases         Purchase[]
  movementSources   StockMovement[]    @relation("MovementSource")
  movementTargets   StockMovement[]    @relation("MovementTarget")
  goodsReceipts     GoodsReceipt[]

  @@unique([branchId, code])
}

model User {
  id           String     @id @default(uuid())
  companyId    String
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  userRoles UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Account {
  id            String        @id @default(uuid())
  companyId     String
  code          String
  name          String
  type          AccountType
  normalBalance NormalBalance
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  journalLines JournalLine[]
  budgets      Budget[]

  @@unique([companyId, code])
}

model CashAccount {
  id             String   @id @default(uuid())
  companyId      String
  code           String
  name           String
  bankName       String?
  accountNumber  String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  currentBalance Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  payments     Payment[]
  transactions Transaction[]

  @@unique([companyId, code])
}

model ServicePackage {
  id           String   @id @default(uuid())
  companyId    String
  code         String
  name         String
  speedMbps    Int
  monthlyPrice Decimal  @db.Decimal(18, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  customers Customer[]

  @@unique([companyId, code])
}

model Customer {
  id               String   @id @default(uuid())
  companyId        String
  branchId         String
  servicePackageId String?
  customerNumber   String
  name             String
  phone            String?
  email            String?
  installAddress   String
  monthlyBill      Decimal  @db.Decimal(18, 2)
  recurringDueDay  Int      @default(10)
  status           String   @default("ACTIVE")
  startedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  servicePackage ServicePackage?  @relation(fields: [servicePackageId], references: [id])
  invoices       Invoice[]
  devices        CustomerDevice[]

  @@unique([companyId, customerNumber])
  @@index([companyId, status])
  @@index([branchId, name])
}

model CustomerDevice {
  id          String    @id @default(uuid())
  customerId  String
  itemId      String
  serial      String?
  macAddress  String?
  installedAt DateTime  @default(now())
  removedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])
}

model Invoice {
  id              String        @id @default(uuid())
  companyId       String
  branchId        String
  customerId      String
  documentNumber  String
  period          String
  issueDate       DateTime
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(18, 2)
  total           Decimal       @db.Decimal(18, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal       @db.Decimal(18, 2)
  status          InvoiceStatus @default(DRAFT)
  version         Int           @default(1)
  postedAt        DateTime?
  reversedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  customer    Customer            @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@unique([companyId, documentNumber])
  @@index([companyId, status, dueDate])
  @@index([customerId, period])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String         @id @default(uuid())
  companyId      String
  branchId       String
  cashAccountId  String
  documentNumber String
  paymentDate    DateTime
  amount         Decimal        @db.Decimal(18, 2)
  method         String
  reference      String?
  status         DocumentStatus @default(POSTED)
  version        Int            @default(1)
  postedAt       DateTime?
  reversedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  cashAccount CashAccount         @relation(fields: [cashAccountId], references: [id])
  allocations PaymentAllocation[]

  @@unique([companyId, documentNumber])
  @@index([companyId, paymentDate, status])
}

model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(18, 2)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
}

model Transaction {
  id              String         @id @default(uuid())
  companyId       String
  cashAccountId   String?
  documentNumber  String
  transactionDate DateTime
  type            String
  description     String
  amount          Decimal        @db.Decimal(18, 2)
  status          DocumentStatus @default(DRAFT)
  sourceType      String?
  sourceId        String?
  version         Int            @default(1)
  postedAt        DateTime?
  reversedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cashAccount  CashAccount?  @relation(fields: [cashAccountId], references: [id])
  journalEntry JournalEntry?

  @@unique([companyId, documentNumber])
  @@index([companyId, transactionDate, status])
}

model JournalEntry {
  id            String        @id @default(uuid())
  transactionId String        @unique
  entryDate     DateTime
  description   String
  createdAt     DateTime      @default(now())
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  lines         JournalLine[]
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])
}

model Supplier {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  purchases Purchase[]

  @@unique([companyId, code])
}

model Purchase {
  id             String         @id @default(uuid())
  companyId      String
  branchId       String
  warehouseId    String?
  supplierId     String
  documentNumber String
  purchaseDate   DateTime
  type           String
  total          Decimal        @db.Decimal(18, 2)
  paymentTerms   String
  status         PurchaseStatus @default(DRAFT)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, documentNumber])
  @@index([companyId, status, purchaseDate])
}

model PurchaseItem {
  id               String             @id @default(uuid())
  purchaseId       String
  itemId           String?
  description      String
  quantity         Decimal            @db.Decimal(12, 3)
  receivedQuantity Decimal            @default(0) @db.Decimal(12, 3)
  unitPrice        Decimal            @db.Decimal(18, 2)
  amount           Decimal            @db.Decimal(18, 2)
  purchase         Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item             Item?              @relation(fields: [itemId], references: [id])
  receiptItems     GoodsReceiptItem[]
}

model GoodsReceipt {
  id             String             @id @default(uuid())
  purchaseId     String
  warehouseId    String
  documentNumber String             @unique
  receivedAt     DateTime
  status         DocumentStatus     @default(POSTED)
  createdAt      DateTime           @default(now())
  purchase       Purchase           @relation(fields: [purchaseId], references: [id])
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id])
  items          GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id             String       @id @default(uuid())
  goodsReceiptId String
  purchaseItemId String
  quantity       Decimal      @db.Decimal(12, 3)
  unitCost       Decimal      @db.Decimal(18, 2)
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id])
}

model ItemCategory {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  isActive  Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id])
  items     Item[]

  @@unique([companyId, code])
}

model Item {
  id           String   @id @default(uuid())
  companyId    String
  categoryId   String
  sku          String
  name         String
  brand        String?
  unit         String
  trackingType String   @default("QUANTITY")
  minimumStock Decimal  @default(0) @db.Decimal(12, 3)
  lastCost     Decimal  @default(0) @db.Decimal(18, 2)
  averageCost  Decimal  @default(0) @db.Decimal(18, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company           Company             @relation(fields: [companyId], references: [id])
  category          ItemCategory        @relation(fields: [categoryId], references: [id])
  inventoryBalances InventoryBalance[]
  movementLines     StockMovementLine[]
  purchaseItems     PurchaseItem[]
  customerDevices   CustomerDevice[]

  @@unique([companyId, sku])
  @@index([companyId, name])
}

model InventoryBalance {
  id          String    @id @default(uuid())
  warehouseId String
  itemId      String
  onHand      Decimal   @default(0) @db.Decimal(12, 3)
  allocated   Decimal   @default(0) @db.Decimal(12, 3)
  inTransit   Decimal   @default(0) @db.Decimal(12, 3)
  damaged     Decimal   @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  item        Item      @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
}

model StockMovement {
  id                String         @id @default(uuid())
  companyId         String
  documentNumber    String
  movementDate      DateTime
  type              MovementType
  status            MovementStatus @default(DRAFT)
  sourceWarehouseId String?
  targetWarehouseId String?
  holderName        String?
  notes             String?
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company         Company             @relation(fields: [companyId], references: [id])
  sourceWarehouse Warehouse?          @relation("MovementSource", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse?          @relation("MovementTarget", fields: [targetWarehouseId], references: [id])
  lines           StockMovementLine[]

  @@unique([companyId, documentNumber])
  @@index([companyId, status, movementDate])
}

model StockMovementLine {
  id         String        @id @default(uuid())
  movementId String
  itemId     String
  quantity   Decimal       @db.Decimal(12, 3)
  condition  String        @default("GOOD")
  movement   StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  item       Item          @relation(fields: [itemId], references: [id])
}

model Budget {
  id        String         @id @default(uuid())
  companyId String
  branchId  String
  accountId String
  period    String
  amount    Decimal        @db.Decimal(18, 2)
  committed Decimal        @default(0) @db.Decimal(18, 2)
  realized  Decimal        @default(0) @db.Decimal(18, 2)
  status    DocumentStatus @default(DRAFT)
  version   Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@unique([branchId, accountId, period])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  module     String
  action     String
  entityType String?
  entityId   String?
  beforeData Json?
  afterData  Json?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}
